# Environment — never commit secrets
.env
.env.local
.env.development
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
build/

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma generated client (see apps/bot/.gitignore for the actual path) — migrations themselves
# are committed source, not generated output, so this rule must not shadow them. CI tests read
# migration SQL straight off disk to build a temp DB, so a silently-untracked new migration would
# pass locally and fail in CI.
!prisma/migrations/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Claude Code
.claude/
.agents/
skills-lock.json
