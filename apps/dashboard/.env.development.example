# Vite dev mode only (`npm run dev`) — copy to .env.development. Vite loads this in addition to
# .env when running in "development" mode, and does NOT load it for `npm run build` (mode
# "production" by default). That split matters: it's what stops a plain `npm run build` from
# baking a direct-to-bot URL/token into the production bundle. In dev, the React app talks
# directly to the bot — there's no proxy in front of it. Never set these in Railway's dashboard
# service Variables.
VITE_API_URL=http://localhost:3000
VITE_API_TOKEN=your-bot-api-token
VITE_WEBHOOK_BASE_URL=http://localhost:3000
