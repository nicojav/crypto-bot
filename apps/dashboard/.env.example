# Server-only vars, read by `npm start` (server/index.js) via dotenv/config — not read by Vite at
# all, so these never end up in the browser bundle regardless of dev/build/mode.
#
# Dev-mode-only VITE_ vars live in .env.development.example instead (copy to .env.development) —
# deliberately kept out of this file so a plain `npm run build` never picks them up. See that
# file's comment, or server/createServer.js's doc comment, for why.
#
# On Railway these are set as service Variables, not via this file — listed here so `npm start`
# also works locally against a real build: `npm run build && npm start --workspace apps/dashboard`.
BOT_URL=http://localhost:3000
API_TOKEN=your-bot-api-token
DASHBOARD_PASSWORD=choose-a-password
