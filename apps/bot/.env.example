# Bybit API credentials (testnet)
BYBIT_API_KEY=your_testnet_api_key
BYBIT_API_SECRET=your_testnet_api_secret
BYBIT_TESTNET=true

# Webhook
# Must be at least 16 characters — used to verify TradingView alert payloads
WEBHOOK_SECRET=change_me_to_a_long_random_string

# Dashboard API
# Must be at least 16 characters — bearer token for REST API and WebSocket
API_TOKEN=change_me_to_a_long_random_string
# Origin of your dashboard (used for CORS)
DASHBOARD_ORIGIN=http://localhost:5173

# Database (Prisma / SQLite)
DATABASE_URL=file:./dev.db

# Server
PORT=3000
LOG_LEVEL=info

# Telegram notifications (optional — leave blank to disable)
# Get BOT_TOKEN from @BotFather, get CHAT_ID from @userinfobot or send a message and check the API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hour (0-23 UTC) to send the daily summary (default: 8 = 8:00 AM UTC)
DAILY_SUMMARY_HOUR_UTC=8
