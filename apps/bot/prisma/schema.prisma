generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bot {
  id               Int       @id @default(autoincrement())
  name             String
  symbol           String
  enabled          Boolean   @default(true)
  dryRun           Boolean   @default(true)
  maxLeverage        Int       @default(10)
  maxPositionUsd     Float     @default(100)
  dailyLossLimitUsd  Float     @default(-500)
  createdAt          DateTime  @default(now())

  signals          Signal[]
  trades           Trade[]
}

model Signal {
  id               Int       @id @default(autoincrement())
  botId            Int
  webhookId        String    @unique
  action           String    // BUY | SELL | CLOSE
  payload          String    // JSON blob
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  status           String    @default("PENDING") // PENDING | EXECUTED | REJECTED | DUPLICATE
  rejectionReason  String?

  bot              Bot       @relation(fields: [botId], references: [id])
  trade            Trade?
}

model Trade {
  id               Int       @id @default(autoincrement())
  botId            Int
  signalId         Int       @unique
  exchangeOrderId  String
  symbol           String
  side             String    // BUY | SELL
  qty              Float
  entryPrice       Float
  exitPrice        Float?
  pnlUsd           Float?
  status           String    @default("OPEN") // OPEN | CLOSING | CLOSED
  openedAt         DateTime  @default(now())
  closedAt         DateTime?

  // Accurate accounting fields — populated from Bybit execution/closedPnl APIs
  entryFillPrice   Float?    // real avgPrice from opening executions
  exitFillPrice    Float?    // real avgPrice from closing executions
  feeOpenUsd       Float?
  feeCloseUsd      Float?
  realizedPnlUsd   Float?    // from Bybit closed-pnl (preferred) or computed from executions
  fundingUsd       Float?
  pnlSource        String?   // BYBIT_WS | EXEC_FALLBACK | BYBIT_LIQUIDATION
  closingOrderId   String?

  // TP/SL bracket — computed at entry time, sent via setTradingStop after order fills
  takeProfitPrice  Float?    // absolute TP price sent to exchange
  stopLossPrice    Float?    // absolute SL price sent to exchange
  tpslSet          Boolean   @default(false) // true if setTradingStop confirmed on Bybit

  bot              Bot       @relation(fields: [botId], references: [id])
  signal           Signal    @relation(fields: [signalId], references: [id])

  @@index([symbol, status])
  @@index([closingOrderId])
}

model BalanceSnapshot {
  id               Int       @id @default(autoincrement())
  equityUsd        Float
  availableUsd     Float
  takenAt          DateTime  @default(now())
}

model FundingEvent {
  id          Int      @id @default(autoincrement())
  symbol      String
  fundingUsd  Float    // negative = paid out, positive = received
  execTime    DateTime
  execId      String   @unique
  createdAt   DateTime @default(now())

  @@index([symbol, execTime])
}

// Cached OHLCV candles for the backtesting tool — downloaded once per symbol+timeframe
// from Bybit and reused across backtest runs (see apps/bot/src/backtest/candleStore.ts).
model Candle {
  id        Int    @id @default(autoincrement())
  symbol    String
  timeframe String   // 5m | 15m | 4h | 1d | 1w
  openTime  Int      // bar open time, ms epoch
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

// Background param-search job runs, started manually from the dashboard's "Strategy Finder"
// panel (backtest/optimizationRunner.ts) — coarse-grid search + out-of-sample validation
// across strategy x symbol x timeframe, so results are ranked defensibly rather than by
// raw (likely overfit) in-sample PnL. configJson/resultsJson are JSON blobs to avoid a
// migration per new field; resultsJson is capped to a bounded top-N by the runner and
// updated as the run progresses (see MAX_STORED_RESULTS in optimizationRunner.ts).
model OptimizationRun {
  id           Int      @id @default(autoincrement())
  status       String   @default("running") // running | done | error | cancelled
  configJson   String   // AutoOptimizeConfig snapshot
  resultsJson  String   @default("[]") // CellResult[], bounded top-N, ranked by out-of-sample score
  cellsTotal   Int      @default(0)
  cellsDone    Int      @default(0)
  backtestsRun Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Persistent audit trail for reconciliation anomalies (dropped fills, qty drift, phantom
// promotions, unmatched closedPnl lookups). Console logs are ephemeral — Railway's log
// retention doesn't reach back far enough to forensically investigate an issue reported
// days later. tradeId is intentionally a bare column (no enforced relation): some events
// have no associated trade (e.g. a fill for an unknown order), and trades can be wiped by
// reset-trade-data without needing to cascade this audit history.
model ReconciliationEvent {
  id          Int      @id @default(autoincrement())
  type        String   // FILL_DROPPED | QTY_DRIFT_DETECTED | PHANTOM_PROMOTED | NO_CLOSEDPNL_MATCH | ...
  tradeId     Int?
  symbol      String?
  message     String
  detailsJson String?  // structured context, e.g. {"orderId":"...","dbQty":30.6,"bybitQty":27.1}
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([symbol, createdAt])
}
