generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bot {
  id               Int       @id @default(autoincrement())
  name             String
  symbol           String
  enabled          Boolean   @default(true)
  dryRun           Boolean   @default(true)
  maxLeverage        Int       @default(10)
  maxPositionUsd     Float     @default(100)
  dailyLossLimitUsd  Float     @default(-500)
  createdAt          DateTime  @default(now())

  signals          Signal[]
  trades           Trade[]
}

model Signal {
  id               Int       @id @default(autoincrement())
  botId            Int
  webhookId        String    @unique
  action           String    // BUY | SELL | CLOSE
  payload          String    // JSON blob
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  status           String    @default("PENDING") // PENDING | EXECUTED | REJECTED | DUPLICATE
  rejectionReason  String?

  bot              Bot       @relation(fields: [botId], references: [id])
  trade            Trade?
}

model Trade {
  id               Int       @id @default(autoincrement())
  botId            Int
  signalId         Int       @unique
  exchangeOrderId  String
  symbol           String
  side             String    // BUY | SELL
  qty              Float
  entryPrice       Float
  exitPrice        Float?
  pnlUsd           Float?
  status           String    @default("OPEN") // OPEN | CLOSING | CLOSED
  openedAt         DateTime  @default(now())
  closedAt         DateTime?

  // Accurate accounting fields — populated from Bybit execution/closedPnl APIs
  entryFillPrice   Float?    // real avgPrice from opening executions
  exitFillPrice    Float?    // real avgPrice from closing executions
  feeOpenUsd       Float?
  feeCloseUsd      Float?
  realizedPnlUsd   Float?    // from Bybit closed-pnl (preferred) or computed from executions
  fundingUsd       Float?
  pnlSource        String?   // BYBIT_WS | EXEC_FALLBACK | BYBIT_LIQUIDATION
  closingOrderId   String?

  // TP/SL bracket — computed at entry time, sent via setTradingStop after order fills
  takeProfitPrice  Float?    // absolute TP price sent to exchange
  stopLossPrice    Float?    // absolute SL price sent to exchange
  tpslSet          Boolean   @default(false) // true if setTradingStop confirmed on Bybit

  bot              Bot       @relation(fields: [botId], references: [id])
  signal           Signal    @relation(fields: [signalId], references: [id])

  @@index([symbol, status])
  @@index([closingOrderId])
}

model BalanceSnapshot {
  id               Int       @id @default(autoincrement())
  equityUsd        Float
  availableUsd     Float
  takenAt          DateTime  @default(now())
}

model FundingEvent {
  id          Int      @id @default(autoincrement())
  symbol      String
  fundingUsd  Float    // negative = paid out, positive = received
  execTime    DateTime
  execId      String   @unique
  createdAt   DateTime @default(now())

  @@index([symbol, execTime])
}
