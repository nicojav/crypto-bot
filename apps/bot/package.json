{
  "name": "@crypto-bot/bot",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "check-bybit": "tsx ../../scripts/check-bybit.ts",
    "reset-trade-data": "tsx ../../scripts/reset-trade-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "bybit-api": "^4.6.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "prisma": "^7.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crypto-bot/eslint-config": "*",
    "@types/node": "^20.12.11",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
